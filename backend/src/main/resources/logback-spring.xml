<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <!-- All profiles use a whitelist. No raw messages, arguments, MDC dump or exception text. -->
    <conversionRule conversionWord="safeEvent" class="cn.dental.shared.logging.SafeEventConverter"/>
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{yyyy-MM-dd'T'HH:mm:ss.SSSXXX} %-5level %safeEvent%nopex%n</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>
    <root level="INFO"><appender-ref ref="CONSOLE"/></root>
</configuration>
