<view class="mini-page">
  <view class="mini-hero">
    <view class="eyebrow">费用与付款记录</view>
    <view class="title">费用透明，先看清楚再决定</view>
    <view class="sub">仅显示本人已登记的记录；本页不发起支付或开票。</view>
  </view>
  <view wx:if="{{!hasSession}}" class="mini-card"><view class="mini-muted">请先登录后查看本人费用记录。</view><button class="mini-btn" bindtap="goLogin">微信登录 / 本人建档</button></view>
  <view wx:if="{{hasSession && error}}" class="mini-card">{{error}}<button class="mini-btn secondary" bindtap="load">重试</button></view>
  <view wx:if="{{loading}}" class="mini-muted">正在读取…</view>

  <view class="mini-tabs">
    <view class="tab {{tab === 'bills' ? 'active' : ''}}" data-tab="bills" bindtap="switchTab">账单</view>
    <view class="tab {{tab === 'payments' ? 'active' : ''}}" data-tab="payments" bindtap="switchTab">付款记录</view>
    <view class="tab {{tab === 'refunds' ? 'active' : ''}}" data-tab="refunds" bindtap="switchTab">退款</view>
    <view class="tab {{tab === 'invoices' ? 'active' : ''}}" data-tab="invoices" bindtap="switchTab">发票</view>
  </view>

  <block wx:if="{{tab === 'bills'}}">
    <view wx:for="{{bills}}" wx:key="bill_id" class="money-card">
      <view class="money-title"><text>账单 {{item.bill_id}}</text><text>{{item.amount}}</text></view>
      <view class="money-meta">{{item.status}} · 已收 {{item.paid}} · 待付 {{item.remaining}}</view>
    </view>
  </block>

  <block wx:elif="{{tab === 'payments'}}">
    <view wx:for="{{payments}}" wx:key="payment_id" class="money-card">
      <view class="money-title"><text>{{item.method}}</text><text>{{item.amount}}</text></view>
      <view class="money-meta">{{item.state}} · 流水 {{item.payment_id}}</view>
    </view>
  </block>

  <block wx:elif="{{tab === 'refunds'}}">
    <view wx:for="{{refunds}}" wx:key="refund_id" class="money-card">
      <view class="money-title"><text>退款 {{item.refund_id}}</text><text>{{item.amount}}</text></view>
      <view class="money-meta">{{item.status}} · {{item.reason}}</view>
    </view>
  </block>

  <block wx:else>
    <view wx:for="{{invoices}}" wx:key="invoice_id" class="money-card">
      <view class="money-title"><text>{{item.title}} · {{item.amount}}</text><text>{{item.status}}</text></view>
      <view class="money-meta">票据 {{item.invoice_id}}</view>
    </view>
  </block>

  <view class="mini-card">
    <view class="card-title">重要说明</view>
    <view class="mini-muted">申请退款、实际退款和票据更正分别记录。需要付款或开票时，请以诊所核验结果为准。</view>
  </view>

  <button class="mini-btn ghost" bindtap="backHome">返回首页</button>
  <view class="mini-foot">本人记录 · 来自诊所后台</view>
</view>
