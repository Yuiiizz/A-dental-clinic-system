.page {
  min-height: 100vh;
  padding: 28rpx 28rpx calc(64rpx + env(safe-area-inset-bottom));
  background: #f7fbfa;
  box-sizing: border-box;
}

.header {
  padding: 12rpx 6rpx 18rpx;
}

.eyebrow {
  color: #2b8a7c;
  font-size: 22rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
}

.title {
  margin-top: 8rpx;
  font-size: 42rpx;
  font-weight: 700;
  color: #1f3b3a;
}

.subtitle {
  margin-top: 10rpx;
  font-size: 24rpx;
  line-height: 1.55;
  color: #6b8583;
}

.form {
  margin-top: 8rpx;
}

.section {
  margin-top: 18rpx;
  padding: 24rpx;
  background: #ffffff;
  border: 1rpx solid #dcebe9;
  border-radius: 16rpx;
  box-sizing: border-box;
}

.section-title {
  font-size: 30rpx;
  font-weight: 650;
  color: #1f3b3a;
}

.section-hint {
  margin-top: 6rpx;
  font-size: 22rpx;
  line-height: 1.55;
  color: #77908a;
}

.field {
  margin-top: 26rpx;
}

.field-head {
  display: flex;
  align-items: baseline;
  gap: 6rpx;
  margin-bottom: 10rpx;
}

.label {
  font-size: 27rpx;
  color: #3d5a58;
  font-weight: 550;
}

.required {
  color: #c35a4b;
  font-size: 26rpx;
}

.optional {
  color: #9aada8;
  font-size: 21rpx;
}

/* 边框放在外层，避免原生 input/textarea 在真机上裁切边框。 */
.control {
  display: flex;
  align-items: center;
  width: 100%;
  min-height: 92rpx;
  padding: 0 20rpx;
  box-sizing: border-box;
  background: #fbfefe;
  border: 1rpx solid #cfe4e1;
  border-radius: 12rpx;
  overflow: hidden;
}

.control.focused {
  border-color: #2f9e9a;
  box-shadow: 0 0 0 4rpx rgba(47, 158, 154, .12);
}

.control.has-error {
  border-color: #d68b7f;
  background: #fffafa;
}

.input {
  width: 100%;
  min-height: 44rpx;
  padding: 0;
  border: 0;
  background: transparent;
  font-size: 28rpx;
  color: #1f3b3a;
  box-sizing: border-box;
}

.picker-control {
  justify-content: space-between;
  font-size: 28rpx;
  color: #1f3b3a;
}

.chevron {
  flex: none;
  margin-left: 12rpx;
  color: #7c9993;
  font-size: 34rpx;
  line-height: 1;
}

.textarea-control {
  align-items: flex-start;
  padding: 16rpx 20rpx;
  min-height: 236rpx;
}

.textarea {
  width: 100%;
  height: 204rpx;
  min-height: 204rpx;
  padding: 0;
  border: 0;
  background: transparent;
  font-size: 27rpx;
  line-height: 1.6;
  color: #1f3b3a;
  box-sizing: border-box;
}

.placeholder {
  color: #9db2ad;
}

.field-hint {
  margin-top: 8rpx;
  color: #8aa19b;
  font-size: 20rpx;
  line-height: 1.5;
}

.field-error {
  margin-top: 8rpx;
  color: #b24434;
  font-size: 21rpx;
  line-height: 1.5;
}

.field-meta {
  display: flex;
  justify-content: space-between;
  gap: 12rpx;
  margin-top: 8rpx;
}

.char-count {
  flex: none;
  color: #9aada8;
  font-size: 20rpx;
}

.privacy-note {
  margin-top: 18rpx;
  padding: 18rpx 20rpx;
  font-size: 23rpx;
  line-height: 1.6;
  color: #6b6b4a;
  background: #fffdf5;
  border: 1rpx solid #eee4c8;
  border-radius: 12rpx;
}

.privacy-title {
  margin-bottom: 4rpx;
  color: #5e5836;
  font-weight: 600;
}

.notice {
  margin: 18rpx 0 0;
  padding: 18rpx 20rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: #6b6b4a;
  background: #fffdf5;
  border: 1rpx solid #eee4c8;
  border-radius: 10rpx;
}

.message {
  color: #8a5a12;
  background: #fff8e8;
  border-color: #f2dfb6;
}

.primary,
.secondary {
  margin-top: 20rpx;
  border-radius: 12rpx;
  font-size: 29rpx;
}

.primary {
  color: #ffffff;
  background: #2f9e9a;
  border: 1rpx solid #2f9e9a;
}

.primary[disabled] {
  color: #f7fbfa;
  background: #9ccac4;
  border-color: #9ccac4;
}

.secondary {
  color: #1f7f79;
  background: #ffffff;
  border: 1rpx solid #b9dcd8;
}

.submit-hint {
  margin-top: 12rpx;
  text-align: center;
  color: #8aa19b;
  font-size: 20rpx;
  line-height: 1.5;
}

.back {
  margin-top: 28rpx;
}

button::after {
  border: none;
}
