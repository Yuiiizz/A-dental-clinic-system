<view class="page">
  <view class="header">
    <view class="title">绑定旧档</view>
    <view class="subtitle">仅使用前台当面核验后交付的一次性绑定凭证。</view>
  </view>

  <view wx:if="{{showForm}}" class="card">
    <view class="field">
      <view class="label">绑定凭证 *</view>
      <input
        class="input"
        value="{{bindingToken}}"
        maxlength="256"
        placeholder="请粘贴前台交付的绑定凭证"
        bindinput="onTokenInput"
      />
    </view>

    <view class="notice">
      本页不通过手机号认领旧档，也不自动合并档案。凭证由前台核验后签发；同手机号不等于本人。
    </view>

    <button class="primary" bindtap="handleSubmit" disabled="{{busy || !canSubmit}}">
      {{busy ? '绑定中…' : '提交绑定'}}
    </button>
  </view>

  <view wx:if="{{message}}" class="notice message">{{message}}</view>

  <button wx:if="{{showRecheck}}" class="secondary" bindtap="handleRecheck" disabled="{{busy}}">
    重新微信登录/核验
  </button>
  <button wx:if="{{showLogin}}" class="primary" bindtap="goLogin" disabled="{{busy}}">
    返回登录
  </button>

  <button class="secondary back" bindtap="goBack" disabled="{{busy}}">返回</button>
</view>
