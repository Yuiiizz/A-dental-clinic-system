.page {
  min-height: 100vh;
  padding: 32rpx 28rpx 56rpx;
  background: #f7fbfa;
  box-sizing: border-box;
}

.header {
  padding: 16rpx 8rpx 20rpx;
}

.title {
  font-size: 42rpx;
  font-weight: 600;
  color: #1f3b3a;
}

.subtitle {
  margin-top: 8rpx;
  font-size: 25rpx;
  color: #6b8583;
}

.card {
  margin-top: 20rpx;
  padding: 28rpx;
  background: #ffffff;
  border: 1rpx solid #dcebe9;
  border-radius: 16rpx;
}

.row {
  display: flex;
  justify-content: space-between;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #eef5f4;
}

.row:last-of-type {
  border-bottom: none;
}

.label {
  font-size: 27rpx;
  color: #6b8583;
}

.value {
  font-size: 29rpx;
  color: #1f3b3a;
}

.status {
  color: #1f7f79;
  font-weight: 600;
}

.hint {
  margin-top: 18rpx;
  font-size: 25rpx;
  line-height: 1.65;
  color: #78908e;
}

.notice {
  margin-top: 20rpx;
  padding: 18rpx 20rpx;
  font-size: 26rpx;
  line-height: 1.6;
  color: #8a5a12;
  background: #fff8e8;
  border: 1rpx solid #f2dfb6;
  border-radius: 10rpx;
}

.primary,
.secondary {
  margin-top: 24rpx;
  border-radius: 12rpx;
  font-size: 29rpx;
}

.primary {
  color: #ffffff;
  background: #2f9e9a;
  border: 1rpx solid #2f9e9a;
}

.secondary {
  color: #1f7f79;
  background: #ffffff;
  border: 1rpx solid #b9dcd8;
}

button::after {
  border: none;
}
.page { padding-bottom: 150rpx; }
.profile-header { display: flex; align-items: center; gap: 20rpx; margin: 12rpx 0 26rpx; padding: 27rpx; border-radius: 25rpx; background: linear-gradient(135deg,#e8f7f2,#f8fcfb); }
.avatar-mark { display: flex; align-items: center; justify-content: center; flex: none; width: 96rpx; height: 96rpx; border-radius: 30rpx; background: #d2ebe3; color: #277d6c; font-size: 53rpx; }
.profile-header .header { padding: 0; }
.profile-header .title { font-size: 35rpx; }
.profile-header .subtitle { font-size: 21rpx; }
.row-icon { display: inline-flex; align-items: center; justify-content: center; width: 43rpx; height: 43rpx; margin-right: 17rpx; border-radius: 12rpx; background: #e9f6f2; color: #218374; font-size: 29rpx; }

.mini-card .card-sub { margin-bottom: 10rpx; }
.mini-row { min-height: 70rpx; }
.mini-row:active { background: #f7fbf9; }
.mini-card .label { display: block; margin: 18rpx 0 8rpx; font-size: 24rpx; }
.mini-card input, .mini-card textarea { box-sizing: border-box; width: 100%; min-height: 74rpx; padding: 14rpx 18rpx; border: 1rpx solid #dcebe7; border-radius: 14rpx; background: #fff; color: #1d4943; }
.mini-card textarea { min-height: 130rpx; }
