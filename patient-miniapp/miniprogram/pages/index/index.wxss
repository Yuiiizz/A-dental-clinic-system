.page {
  min-height: 100vh;
  padding: 32rpx 28rpx 56rpx;
  background: #f7fbfa;
  box-sizing: border-box;
}

.hero {
  padding: 32rpx 8rpx 24rpx;
}

.hero-title {
  font-size: 44rpx;
  font-weight: 600;
  color: #1f3b3a;
}

.hero-subtitle {
  margin-top: 8rpx;
  font-size: 26rpx;
  color: #6b8583;
}

.card {
  margin-top: 20rpx;
  padding: 28rpx;
  background: #ffffff;
  border: 1rpx solid #dcebe9;
  border-radius: 16rpx;
}

.card.muted {
  background: #fbfefe;
}

.status-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.status-label {
  font-size: 28rpx;
  color: #6b8583;
}

.status-value {
  font-size: 30rpx;
  font-weight: 600;
  color: #1f7f79;
}

.section-title {
  margin-bottom: 12rpx;
  font-size: 30rpx;
  font-weight: 600;
  color: #1f3b3a;
}

.hint {
  font-size: 25rpx;
  line-height: 1.65;
  color: #78908e;
}

.notice {
  margin-top: 20rpx;
  padding: 18rpx 20rpx;
  font-size: 26rpx;
  line-height: 1.6;
  color: #8a5a12;
  background: #fff8e8;
  border: 1rpx solid #f2dfb6;
  border-radius: 10rpx;
}

.primary,
.secondary {
  margin-top: 24rpx;
  border-radius: 12rpx;
  font-size: 30rpx;
}

.primary {
  color: #ffffff;
  background: #2f9e9a;
  border: 1rpx solid #2f9e9a;
}

.secondary {
  color: #1f7f79;
  background: #ffffff;
  border: 1rpx solid #b9dcd8;
}

button::after {
  border: none;
}

.guide-overlay { position: fixed; inset: 0; z-index: 20; display: flex; align-items: center; justify-content: center; padding: 36rpx; background: rgba(20, 45, 44, .48); }
.guide-panel { width: 100%; padding: 36rpx; box-sizing: border-box; border-radius: 24rpx; background: #fff; box-shadow: 0 20rpx 60rpx rgba(20, 45, 44, .2); }
