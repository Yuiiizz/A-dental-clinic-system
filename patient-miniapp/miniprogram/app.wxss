page {
  background-color: #f7fbfa;
  color: #1f3b3a;
  font-family: -apple-system, BlinkMacSystemFont, 'Helvetica Neue', Helvetica, sans-serif;
}

/* 与管理端共用浅薄荷、雾蓝和暖橙的视觉语汇。 */
.demo-banner {
  margin: 16rpx 24rpx 0;
  padding: 14rpx 18rpx;
  border-radius: 12rpx;
  background: #fff4dd;
  color: #7b5518;
  font-size: 22rpx;
  line-height: 1.55;
}
.mini-page {
  min-height: 100vh;
  padding: 24rpx 24rpx 56rpx;
  box-sizing: border-box;
}
.mini-hero {
  padding: 30rpx;
  border-radius: 20rpx;
  background: linear-gradient(135deg, #eaf8f5, #e8f3fb 68%, #f3f7fb);
  color: #244f4c;
}
.mini-hero .eyebrow { color: #35897f; font-size: 21rpx; }
.mini-hero .title { margin-top: 8rpx; font-size: 40rpx; font-weight: 700; }
.mini-hero .sub { margin-top: 10rpx; color: #5c807b; font-size: 23rpx; line-height: 1.55; }
.mini-card {
  margin-top: 18rpx;
  padding: 22rpx;
  border-radius: 16rpx;
  background: #fff;
  border: 1rpx solid #dcebe7;
}
.mini-card .card-title { font-size: 29rpx; font-weight: 650; color: #193f3b; }
.mini-card .card-sub { margin-top: 6rpx; color: #6c8882; font-size: 22rpx; line-height: 1.55; }
.mini-row { display: flex; justify-content: space-between; align-items: center; padding: 13rpx 0; border-bottom: 1rpx solid #eef5f2; font-size: 24rpx; }
.mini-row:last-child { border-bottom: 0; }
.mini-row .label { color: #6e8984; }
.mini-row .value { color: #1c3d39; text-align: right; max-width: 62%; }
.mini-btn { margin-top: 18rpx; border-radius: 12rpx; background: #278e84; color: #fff; font-size: 26rpx; }
.mini-btn.secondary { background: #e7f5f0; color: #146455; }
.mini-btn.ghost { background: #fff; color: #2a675d; border: 1rpx solid #b9dcd3; }
.mini-badge { display: inline-block; padding: 4rpx 10rpx; border-radius: 999rpx; background: #eaf4f1; color: #4c6d67; font-size: 20rpx; }
.mini-badge.good { background: #dff4e9; color: #1d6b52; }
.mini-badge.warn { background: #fff1d8; color: #855811; }
.mini-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 12rpx; margin-top: 16rpx; }
.mini-grid .mini-card { margin-top: 0; }
.mini-link { color: #176e5e; font-size: 23rpx; }
.mini-muted { color: #7d9690; font-size: 21rpx; line-height: 1.6; }
.error { margin-top: 16rpx; padding: 14rpx 16rpx; border-radius: 10rpx; background: #fff1f0; color: #9f2f2f; font-size: 22rpx; line-height: 1.6; }
.mini-list-item { padding: 15rpx 0; border-bottom: 1rpx solid #edf4f2; }
.mini-list-item:last-child { border-bottom: 0; }
.mini-chip { display: inline-block; margin: 6rpx 8rpx 0 0; padding: 6rpx 12rpx; border-radius: 8rpx; background: #f0f8f5; color: #316d62; font-size: 21rpx; }
.mini-input { margin-top: 10rpx; padding: 14rpx; border: 1rpx solid #cfe2dc; border-radius: 10rpx; background: #fff; font-size: 24rpx; }
.mini-tabs { display: flex; gap: 8rpx; margin-top: 16rpx; }
.mini-tabs .tab { flex: 1; text-align: center; padding: 13rpx 0; border-radius: 10rpx; background: #eef6f3; color: #55756e; font-size: 23rpx; }
.mini-tabs .tab.active { background: #278e84; color: #fff; }
.mini-foot { margin-top: 28rpx; color: #8aa09b; font-size: 20rpx; text-align: center; line-height: 1.6; }
.bottom-nav { position: fixed; bottom: 0; left: 0; right: 0; z-index: 10; display: flex; justify-content: space-around; padding: 12rpx 0 calc(12rpx + env(safe-area-inset-bottom)); background: rgba(255,255,255,.98); border-top: 1rpx solid #e5efec; }
.nav-item { display: flex; flex-direction: column; align-items: center; min-width: 130rpx; color: #8a9e99; font-size: 20rpx; }
.nav-item.active { color: #15796a; font-weight: 600; }
.nav-symbol { font-size: 42rpx; line-height: 1.15; margin-bottom: 3rpx; }

.nav-icon { width: 44rpx; height: 44rpx; margin-bottom: 4rpx; opacity: .55; }
.nav-item.active .nav-icon { opacity: 1; }
.nav-item { min-height: 92rpx; justify-content: center; }
.nav-item:active { opacity: .7; }
