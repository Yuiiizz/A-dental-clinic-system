@startuml
hide circle
skinparam defaultFontName Microsoft YaHei
skinparam defaultFontSize 16
skinparam backgroundColor white
skinparam shadowing false
skinparam linetype ortho
skinparam ArrowColor black
skinparam ArrowThickness 1
skinparam classBorderColor black
skinparam classBackgroundColor white
skinparam classAttributeIconSize 0
skinparam packageBorderColor #A0A0A0
skinparam packageStyle rectangle
skinparam noteBackgroundColor white
skinparam noteBorderColor black
skinparam nodesep 105
skinparam ranksep 75
skinparam dpi 150
title 图32  患者预约与实际接诊类图
package "患者预约与实际接诊" #white {
class "患者" as P {
编号、姓名、联系方式
当前过敏申报
}
class "预约就诊" as A {
时间、状态、事项
+确认预约()
+登记到诊()
}
class "出诊安排" as S {
开始、结束、服务类型、状态
}
class "牙医" as D {
执业标识
+确认诊疗事实()
+制定复诊建议()
}
class "接诊记录" as V {
本次健康核对、开始及完成时间
+登记核对()
+准备结算()
}
}
P "1" -right- "0..*" A : 申请
P "0..*" -down- "0..1" D : 主治
A "0..*" -down- "0..1" S : 确认排班
S "0..*" -right- "1" D : 出诊
A "1" -down- "0..1" V : 形成接诊
V "0..*" -right- "1" D : 实际接诊
A "0..*" -right- "0..1" D : 意向牙医
legend bottom
待确认预约可无排班；确认后必须有排班。
主治牙医不因临时替诊改变；交接按任期保存。
改约方案分别关联原预约与候选预约；成功后继至多一个。
endlegend
@enduml
