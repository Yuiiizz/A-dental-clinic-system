@startuml
hide circle
skinparam defaultFontName Microsoft YaHei
skinparam defaultFontSize 16
skinparam backgroundColor white
skinparam shadowing false
skinparam linetype ortho
skinparam ArrowColor black
skinparam ArrowThickness 1
skinparam classBorderColor black
skinparam classBackgroundColor white
skinparam classAttributeIconSize 0
skinparam packageBorderColor #A0A0A0
skinparam packageStyle rectangle
skinparam noteBackgroundColor white
skinparam noteBorderColor black
skinparam nodesep 105
skinparam ranksep 75
skinparam dpi 150
title 预约服务与资源需求类图
class "预约就诊" as A {
时间、状态、事项
+确认预约()
+登记到诊()
}
class "预约拟做项目" as AI {
预计数量、待核实事项
}
class "治疗项目" as T {
名称、计价单位、当前参考价
}
class "牙医可提供服务" as DS {
开放状态、核实时间
}
class "牙医" as D {
执业标识
+确认诊疗事实()
+制定复诊建议()
}
class "服务资源需求" as SR {
所需数量、周转时间
}
class "资源类别" as RC {
类别代码、名称、启用状态
}
class "诊疗资源" as R {
编号、类型、运行状态
+登记停用()
}
RC "1" -down- "0..*" R : 资源分类
T "1" *-down- "0..*" SR : 资源需求
RC "1" -down- "0..*" SR : 所需类别
D "1" -down- "0..*" DS : 开放范围
T "1" -down- "0..*" DS : 可提供项目
A "1" *-down- "0..*" AI : 预约需求
T "1" -down- "0..*" AI : 拟做项目
legend bottom
拟做项目不等于实施或收费；确认后至少有一个可预约项目。
服务范围、设备类别和具体时段占用共同校验。
endlegend
@enduml
