@startuml
skinparam defaultFontName SimSun
skinparam defaultFontSize 17
skinparam backgroundColor white
skinparam shadowing false
skinparam ArrowColor black
skinparam classBorderColor black
skinparam classBackgroundColor #white
skinparam classAttributeIconSize 0
skinparam noteBackgroundColor #white
skinparam noteBorderColor black
skinparam stateBackgroundColor #white
skinparam stateBorderColor black
skinparam stateArrowColor black
skinparam dpi 160
skinparam nodesep 55
skinparam ranksep 55
hide circle

skinparam usecaseBackgroundColor #DDEEF9
skinparam actorBackgroundColor #FBE4CF
skinparam sequenceActorBackgroundColor #FBE4CF
skinparam sequenceParticipantBackgroundColor #DDF1ED
skinparam sequenceLifeLineBackgroundColor #E0F0EE
skinparam sequenceGroupBackgroundColor #DFEEF5
skinparam sequenceReferenceBackgroundColor #E0F1EC
skinparam sequenceReferenceHeaderBackgroundColor #D5EAE5
skinparam noteBackgroundColor #FFF5DF
skinparam stateBackgroundColor #DDF1ED
skinparam componentBackgroundColor #DDF1ED
skinparam databaseBackgroundColor #DDEEF9

title 图40  预约就诊取消与改约状态机图

state "接诊前" as B {
 state "待确认" as P
 state "已确认" as C #DDF1E9
 state "候诊中" as W
 P -[hidden]down-> C
 C -[hidden]down-> W
}
state "已取消" as X #FBE4CF
state "未到" as N #FFF0CF
state "已改约" as R #FBE4CF
B --> X : 取消\n[身份与规则通过]\n/ 释放已有占用并留痕
C --> N : 核实未到\n[已过时限且未签到]\n/ 保存核实依据
C --> R : 确认改约\n[新安排保存成功]\n/ 原子替换占用并关联后继
@enduml
