title 图08  复诊安排与提醒业务序列图
actor "<u>:患者</u>" as P
participant "<$worker,scale=0.65>\n<u>:牙医</u>" as D
participant "<$worker,scale=0.65>\n<u>:前台人员</u>" as F
participant "<$businessEntity,scale=0.65>\n<u>:诊所管理系统</u>" as M

D -> M : 保存复诊计划(建议日期、预计时长)
activate M #E0F0EE
deactivate M
F -> M : 查询待协调计划及资源时段()
activate M #E0F0EE
deactivate M
F -> P : 确认可到店的医生与时段()
activate P #E0F0EE
deactivate P
F -> M : 确认复诊或替诊安排并保存占用()
activate M #E0F0EE
M -> M : 建立到诊提醒任务()
deactivate M
F -> M : 处理提醒发送并查询待联系事项()
activate M #E0F0EE
M -->> F : 发送失败或尚未确认的事项
deactivate M
F -> P : 确认是否收到就诊安排()
activate P #E0F0EE
deactivate P
F -> M : 保存联系结果与待办状态()
activate M #E0F0EE
deactivate M
@enduml
