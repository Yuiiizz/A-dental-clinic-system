{field} termination_reason\n  <color:#777777>varchar(300) ?</color>
}
entity "联系与提醒记录\ncontact_record" as contact_record {
{field} [<color:#176CA4><b>PK</b></color>] contact_id\n  <color:#777777>bigint</color>
{field} [<color:#218653><b>FK</b></color>] plan_id\n  <color:#218653>→ followup_plan.plan_id ?</color>
{field} [<color:#218653><b>FK</b></color>] appointment_id\n  <color:#218653>→ appointment.appointment_id ?</color>
{field} kind\n  <color:#777777>varchar(20)</color>
{field} channel\n  <color:#777777>varchar(20)</color>
{field} planned_at\n  <color:#777777>timestamp ?</color>
{field} contacted_at\n  <color:#777777>timestamp ?</color>
{field} state\n  <color:#777777>varchar(20)</color>
{field} result\n  <color:#777777>varchar(300) ?</color>
{field} acknowledged_at\n  <color:#777777>timestamp ?</color>
{field} acknowledgment_basis\n  <color:#777777>varchar(300) ?</color>
{field} next_contact_at\n  <color:#777777>timestamp ?</color>
{field} [<color:#218653><b>FK</b></color>] staff_id\n  <color:#218653>→ staff.staff_id ?</color>
{field} [<color:#467DA6><b>UQ</b></color>/<color:#218653><b>FK</b></color>] retry_of_id\n  <color:#218653>→ contact_record.contact_id ?</color>
}
}
package "到店候诊" as G4 #F0EDF7 {
entity "候诊登记\nqueue_ticket" as queue_ticket {
{field} [<color:#176CA4><b>PK</b></color>] ticket_id\n  <color:#777777>bigint</color>
{field} [<color:#467DA6><b>UQ</b></color>/<color:#218653><b>FK</b></color>] appointment_id\n  <color:#218653>→ appointment.appointment_id</color>
{field} queue_date\n  <color:#777777>date</color>
{field} queue_no\n  <color:#777777>integer</color>
{field} [<color:#218653><b>FK</b></color>] registered_by\n  <color:#218653>→ staff.staff_id</color>
{field} registered_at\n  <color:#777777>timestamp</color>
{field} state\n  <color:#777777>varchar(20)</color>
{field} priority\n  <color:#777777>integer</color>
{field} priority_reason\n  <color:#777777>varchar(300) ?</color>
{field} closed_at\n  <color:#777777>timestamp ?</color>
}
entity "叫号记录\nqueue_call" as queue_call {
{field} [<color:#176CA4><b>PK</b></color>] call_id\n  <color:#777777>bigint</color>
{field} [<color:#218653><b>FK</b></color>] ticket_id\n  <color:#218653>→ queue_ticket.ticket_id</color>
{field} attempt_no\n  <color:#777777>integer</color>
{field} [<color:#218653><b>FK</b></color>] called_by\n  <color:#218653>→ staff.staff_id</color>
{field} called_at\n  <color:#777777>timestamp</color>
{field} answered_at\n  <color:#777777>timestamp ?</color>
{field} result\n  <color:#777777>varchar(20)</color>
}
}
