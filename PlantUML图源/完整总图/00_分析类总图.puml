@startuml
hide circle
skinparam defaultFontName Microsoft YaHei
skinparam defaultFontSize 19
skinparam backgroundColor white
skinparam shadowing false
skinparam linetype ortho
skinparam ArrowColor #657575
skinparam ArrowThickness 1
skinparam classBorderColor black
skinparam classBackgroundColor white
skinparam classAttributeIconSize 0
skinparam packageBorderColor #A0A0A0
skinparam packageStyle rectangle
skinparam noteBackgroundColor white
skinparam noteBorderColor black
skinparam nodesep 105
skinparam ranksep 75
skinparam dpi 150
skinparam minClassWidth 220
skinparam backgroundColor #white
title A口腔诊所分析类总图
skinparam nodesep 35
skinparam ranksep 50
package "身份与人员" as G0 #white {
class "患者" as P {
编号、姓名、联系方式
当前过敏申报
}
class "工作人员" as W {
编号、姓名、在岗状态
}
class "牙医" as D {
执业标识
+确认诊疗事实()
+制定复诊建议()
}
class "人员资格" as Q {
类别、证件号、有效期
}
class "诊所" as O {
名称、地址、负责人
}
class "登录账号" as K {
登录名、启用状态
身份绑定、授权版本
}
class "操作日志" as G {
对象标识、前后值
操作者、原因、时间
}
class "主治交接记录" as XA {
生效及终止时间、确认依据
交接原因
}
class "系统角色" as RL {
角色代码、身份类别
}
class "操作权限" as PM {
权限代码、允许操作
}
class "账号角色" as AR {
授予时间、批准依据
}
class "登录会话" as SS {
令牌摘要、授权版本、失效时间
}
}
package "预约与资源" as G1 #white {
class "出诊安排" as S {
开始、结束、服务类型、状态
}
class "预约就诊" as A {
时间、状态、事项
+确认预约()
+登记到诊()
}
class "诊疗资源" as R {
编号、类型、运行状态
+登记停用()
}
class "不可用时段" as U {
开始、结束、原因
}
class "资源占用" as B {
开始、结束、状态
}
class "医生停诊时段" as XD {
开始、结束、原因、状态
}
class "改约方案" as XC {
提出及答复时间、原因、状态
+登记答复()
+落实方案()
}
class "资源类别" as RC {
类别代码、名称、启用状态
}
class "服务资源需求" as SR {
所需数量、周转时间
}
class "牙医可提供服务" as DS {
开放状态、核实时间
}
class "预约拟做项目" as AI {
预计数量、待核实事项
}
}
package "接诊与费用" as G2 #white {
class "接诊记录" as V {
本次健康核对、开始及完成时间
+登记核对()
+准备结算()
}
class "治疗项目" as T {
名称、计价单位、当前参考价
}
class "诊疗项目记录" as I {
状态、项目快照
/实施小计
+保存告知()
+确认实施()
}
class "结算单" as F {
单号、序号、状态
/总额
+确认开单()
}
class "结算明细" as L {
名称、品牌、单位快照
数量、单价
/行金额
}
class "费用告知" as N <<值对象>> {
预计数量、告知单价
品牌、确认时间与依据
}
class "实施信息" as E <<值对象>> {
实际数量、实际单价
实施人、实施时间
}
class "项目调价记录" as XP {
即时生效时间、参考价、原因
}
class "接诊补记" as XV {
作者、时间、原因、追加内容
}
class "诊疗服务分类" as SC {
代码、名称、开放状态
}
}
package "复诊与联系" as G3 #white {
class "复诊计划" as H {
建议日期、事项、状态
+关联后续预约()
}
class "联系与提醒记录" as M {
类型、渠道、时间、结果
知晓时间与依据
+登记联系()
}
}
package "到店候诊" as G4 #white {
class "候诊登记" as QT {
当日号码、排序等级、状态
+登记过号()
+登记回队()
}
class "叫号记录" as QC {
呼叫序号、时间、结果
+登记回应()
}
}
' 申请
P "1" -- "0..*" A
' 主治
P "0..*" -- "0..1" D
' 确认排班
A "0..*" -- "0..1" S
' 出诊
S "0..*" -- "1" D
' 形成接诊
A "1" -- "0..1" V
' 实际接诊
V "0..*" -- "1" D
' 意向牙医
A "0..*" -- "0..1" D
' 本次项目
V "1" *-- "0..*" I
' 目录依据
I "0..*" -- "1" T
' 历次结算
V "1" -- "0..*" F
' 结算明细
F "1" *-- "0..*" L
' 实施依据
L "0..*" -- "1" I
' 配置
O "1" -- "0..*" R
' 禁用时段
R "1" *-- "0..*" U
' 占用对象
R "1" -- "0..*" B
' 使用安排
A "1" *-- "0..*" B
' 
W <|-- D
' 持有
W "1" *-- "0..*" Q
' 工作人员
O "1" o-- "0..*" W
' 本诊所安排
O "1" -- "0..*" S
' 来源
V "1" -- "0..*" H
' 制定
D "1" -- "0..*" H
' 后续预约
H "0..1" -- "0..*" A
' 计划协调
H "0..1" -- "0..*" M
' 预约联系
A "0..1" -- "0..*" M
' 告知部分
I "1" *-- "1" N
' 实施部分
I "1" *-- "0..1" E
' 患者身份
P "0..1" -- "0..1" K
' 员工身份
W "0..1" -- "0..1" K
' 操作者
K "0..1" -- "0..*" G
' 原预约 / 候选后继
A "0..1" -- "0..*" A
' 原项目 / 更正后继
I "0..1" -- "0..1" I
' 原单 / 候选更正单
F "0..1" -- "0..*" F
' 原计划 / 更正后继
H "0..1" -- "0..1" H
' 原尝试 / 重试后继
M "0..1" -- "0..1" M
' 主治任期
P "1" *-- "0..*" XA
' 承担主治
D "1" -- "0..*" XA
' 前任 / 后任
XA "0..1" -- "0..1" XA
' 停诊
D "1" -- "0..*" XD
' 原预约
A "1" -- "0..*" XC
' 候选预约
A "1" -- "0..1" XC
' 停诊原因
XD "0..1" -- "0..*" XC
' 资源原因
U "0..1" -- "0..*" XC
' 历次定价
T "1" *-- "1..*" XP
' 追加补记
V "1" *-- "0..*" XV
' 补记作者
D "1" -- "0..*" XV
' 原补记 / 更正后继
XV "0..1" -- "0..1" XV
' 资源分类
RC "1" -- "0..*" R
' 资源需求
T "1" *-- "0..*" SR
' 所需类别
RC "1" -- "0..*" SR
' 开放范围
D "1" -- "0..*" DS
' 可提供项目
T "1" -- "0..*" DS
' 预约需求
A "1" *-- "0..*" AI
' 拟做项目
T "1" -- "0..*" AI
' 签到候诊
A "1" -- "0..1" QT
' 历次叫号
QT "1" *-- "0..*" QC
' 登记人
W "1" -- "0..*" QT
' 呼叫人
W "1" -- "0..*" QC
' 角色授予
K "1" -- "0..*" AR
' 角色归属
RL "1" -- "0..*" AR
' 允许操作
RL "0..*" -- "0..*" PM
' 登录会话
K "1" *-- "0..*" SS
' 目录分类
SC "1" -- "0..*" T
legend bottom
实心菱形：组合，位于整体端；空心菱形：共享聚合，位于整体端；空心三角形：指向父类。
数量按对象全生命周期表达：结算草稿允许0条明细，有效单至少1条。
{x o r} 账号身份、联系归属均二选一；每份复诊计划同时至多一笔当前有效预约。
诊所采用受控配置；牙医与工作人员合表；告知与实施值对象合入诊疗项目记录表。
自关联两端按原记录与后继阅读；所有更正链不得成环。
分析类保留主要业务关系；ER总图另列经办人、核实人等全部外键。
endlegend
@enduml
