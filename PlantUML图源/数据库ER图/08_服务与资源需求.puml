@startuml
hide circle
skinparam defaultFontName Microsoft YaHei
skinparam defaultFontSize 16
skinparam backgroundColor white
skinparam shadowing false
skinparam linetype ortho
skinparam ArrowColor black
skinparam ArrowThickness 1
skinparam classBorderColor black
skinparam classBackgroundColor white
skinparam classAttributeIconSize 0
skinparam packageBorderColor transparent
skinparam packageStyle rectangle
skinparam noteBackgroundColor white
skinparam noteBorderColor black
skinparam nodesep 45
skinparam ranksep 45
skinparam dpi 150
title 服务与资源需求数据库 ER 图
hide methods
package "服务与资源需求" #EAF5F2 {
entity "资源类别\nresource_category" as resource_category {
{field} [<color:#176CA4><b>PK</b></color>] category_id\n  <color:#777777>bigint</color>
}
entity "服务资源需求\nservice_resource_requirement" as service_resource_requirement {
{field} [<color:#176CA4><b>PK</b></color>/<color:#218653><b>FK</b></color>] item_id\n  <color:#218653>→ service_item.item_id</color>
{field} [<color:#176CA4><b>PK</b></color>/<color:#218653><b>FK</b></color>] category_id\n  <color:#218653>→ resource_category.category_id</color>
}
entity "牙医可提供服务\ndentist_service" as dentist_service {
{field} [<color:#176CA4><b>PK</b></color>/<color:#218653><b>FK</b></color>] dentist_id\n  <color:#218653>→ staff.staff_id</color>
{field} [<color:#176CA4><b>PK</b></color>/<color:#218653><b>FK</b></color>] item_id\n  <color:#218653>→ service_item.item_id</color>
}
entity "预约拟做项目\nappointment_item" as appointment_item {
{field} [<color:#176CA4><b>PK</b></color>/<color:#218653><b>FK</b></color>] appointment_id\n  <color:#218653>→ appointment.appointment_id</color>
{field} [<color:#176CA4><b>PK</b></color>/<color:#218653><b>FK</b></color>] item_id\n  <color:#218653>→ service_item.item_id</color>
}
}
package "其他模块引用  同名表为同一张表" #EAF3F8 {
entity "预约就诊\nappointment" as appointment {
{field} [<color:#176CA4><b>PK</b></color>] appointment_id\n  <color:#777777>bigint</color>
}
entity "治疗项目\nservice_item" as service_item {
{field} [<color:#176CA4><b>PK</b></color>] item_id\n  <color:#777777>bigint</color>
}
entity "工作人员\nstaff" as staff {
{field} [<color:#176CA4><b>PK</b></color>] staff_id\n  <color:#777777>bigint</color>
}
}
' FK service_resource_requirement.item_id > service_item.item_id
service_item ||--o{ service_resource_requirement
' FK service_resource_requirement.category_id > resource_category.category_id
resource_category ||--o{ service_resource_requirement
' FK dentist_service.dentist_id > staff.staff_id
staff ||--o{ dentist_service
' FK dentist_service.item_id > service_item.item_id
service_item ||--o{ dentist_service
' FK appointment_item.appointment_id > appointment.appointment_id
appointment ||--o{ appointment_item
' FK appointment_item.item_id > service_item.item_id
service_item ||--o{ appointment_item
legend bottom
蓝色 PK：主键；绿色 FK：外键；蓝灰色 UQ：单列唯一。多个 PK 字段共同组成联合主键。
PK 主键   FK 外键   UQ 唯一   ? 可空
字段下方的 → 指向被引用表及主键。
图示全部主外键；完整业务字段见数据字典。
endlegend
@enduml
