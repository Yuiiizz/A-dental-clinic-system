@startuml
hide circle
skinparam defaultFontName Microsoft YaHei
skinparam defaultFontSize 16
skinparam backgroundColor white
skinparam shadowing false
skinparam linetype ortho
skinparam ArrowColor black
skinparam ArrowThickness 1
skinparam classBorderColor black
skinparam classBackgroundColor white
skinparam classAttributeIconSize 0
skinparam packageBorderColor transparent
skinparam packageStyle rectangle
skinparam noteBackgroundColor white
skinparam noteBorderColor black
skinparam nodesep 45
skinparam ranksep 45
skinparam dpi 150
title 到店候诊数据库 ER 图
hide methods
package "到店候诊" #EAF5F2 {
entity "候诊登记\nqueue_ticket" as queue_ticket {
{field} [<color:#176CA4><b>PK</b></color>] ticket_id\n  <color:#777777>bigint</color>
{field} [<color:#467DA6><b>UQ</b></color>/<color:#218653><b>FK</b></color>] appointment_id\n  <color:#218653>→ appointment.appointment_id</color>
{field} [<color:#218653><b>FK</b></color>] registered_by\n  <color:#218653>→ staff.staff_id</color>
}
entity "叫号记录\nqueue_call" as queue_call {
{field} [<color:#176CA4><b>PK</b></color>] call_id\n  <color:#777777>bigint</color>
{field} [<color:#218653><b>FK</b></color>] ticket_id\n  <color:#218653>→ queue_ticket.ticket_id</color>
{field} [<color:#218653><b>FK</b></color>] called_by\n  <color:#218653>→ staff.staff_id</color>
}
}
package "其他模块引用  同名表为同一张表" #EAF3F8 {
entity "预约就诊\nappointment" as appointment {
{field} [<color:#176CA4><b>PK</b></color>] appointment_id\n  <color:#777777>bigint</color>
}
entity "工作人员\nstaff" as staff {
{field} [<color:#176CA4><b>PK</b></color>] staff_id\n  <color:#777777>bigint</color>
}
}
' FK queue_ticket.appointment_id > appointment.appointment_id
appointment ||--o| queue_ticket
' FK queue_ticket.registered_by > staff.staff_id
staff ||--o{ queue_ticket
' FK queue_call.ticket_id > queue_ticket.ticket_id
queue_ticket ||--o{ queue_call
' FK queue_call.called_by > staff.staff_id
staff ||--o{ queue_call
legend bottom
蓝色 PK：主键；绿色 FK：外键；蓝灰色 UQ：单列唯一。多个 PK 字段共同组成联合主键。
PK 主键   FK 外键   UQ 唯一   ? 可空
字段下方的 → 指向被引用表及主键。
图示全部主外键；完整业务字段见数据字典。
endlegend
@enduml
