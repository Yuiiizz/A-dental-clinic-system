@startuml
hide circle
skinparam defaultFontName Microsoft YaHei
skinparam defaultFontSize 16
skinparam backgroundColor white
skinparam shadowing false
skinparam linetype ortho
skinparam ArrowColor black
skinparam ArrowThickness 1
skinparam classBorderColor black
skinparam classBackgroundColor white
skinparam classAttributeIconSize 0
skinparam packageBorderColor transparent
skinparam packageStyle rectangle
skinparam noteBackgroundColor white
skinparam noteBorderColor black
skinparam nodesep 45
skinparam ranksep 45
skinparam dpi 150
title 结算与明细数据库 ER 图
hide methods
package "结算与明细" #EAF5F2 {
entity "结算单\nbill" as bill {
{field} [<color:#176CA4><b>PK</b></color>] bill_id\n  <color:#777777>bigint</color>
{field} [<color:#218653><b>FK</b></color>] visit_id\n  <color:#218653>→ visit_record.visit_id</color>
{field} [<color:#218653><b>FK</b></color>] supersedes_id\n  <color:#218653>→ bill.bill_id ?</color>
{field} [<color:#218653><b>FK</b></color>] created_by\n  <color:#218653>→ staff.staff_id</color>
}
entity "结算明细\nbill_line" as bill_line {
{field} [<color:#176CA4><b>PK</b></color>/<color:#218653><b>FK</b></color>] bill_id\n  <color:#218653>→ bill.bill_id</color>
{field} [<color:#176CA4><b>PK</b></color>] line_no\n  <color:#777777>integer</color>
{field} [<color:#218653><b>FK</b></color>] care_id\n  <color:#218653>→ care_item.care_id</color>
}
}
package "其他模块引用  同名表为同一张表" #EAF3F8 {
entity "诊疗项目记录\ncare_item" as care_item {
{field} [<color:#176CA4><b>PK</b></color>] care_id\n  <color:#777777>bigint</color>
}
entity "工作人员\nstaff" as staff {
{field} [<color:#176CA4><b>PK</b></color>] staff_id\n  <color:#777777>bigint</color>
}
entity "接诊记录\nvisit_record" as visit_record {
{field} [<color:#176CA4><b>PK</b></color>] visit_id\n  <color:#777777>bigint</color>
}
}
' FK bill.visit_id > visit_record.visit_id
visit_record ||--o{ bill
' FK bill.supersedes_id > bill.bill_id
bill |o--o{ bill
' FK bill.created_by > staff.staff_id
staff ||--o{ bill
' FK bill_line.bill_id > bill.bill_id
bill ||--o{ bill_line
' FK bill_line.care_id > care_item.care_id
care_item ||--o{ bill_line
legend bottom
蓝色 PK：主键；绿色 FK：外键；蓝灰色 UQ：单列唯一。多个 PK 字段共同组成联合主键。
PK 主键   FK 外键   UQ 唯一   ? 可空
字段下方的 → 指向被引用表及主键。
图示全部主外键；完整业务字段见数据字典。
endlegend
@enduml
