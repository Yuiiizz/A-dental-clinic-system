@startuml
hide circle
skinparam defaultFontName Microsoft YaHei
skinparam defaultFontSize 16
skinparam backgroundColor white
skinparam shadowing false
skinparam linetype ortho
skinparam ArrowColor black
skinparam ArrowThickness 1
skinparam classBorderColor black
skinparam classBackgroundColor white
skinparam classAttributeIconSize 0
skinparam packageBorderColor transparent
skinparam packageStyle rectangle
skinparam noteBackgroundColor white
skinparam noteBorderColor black
skinparam nodesep 45
skinparam ranksep 45
skinparam dpi 150
title 复诊与联系数据库 ER 图
hide methods
package "复诊与联系" #EAF5F2 {
entity "复诊计划\nfollowup_plan" as followup_plan {
{field} [<color:#176CA4><b>PK</b></color>] plan_id\n  <color:#777777>bigint</color>
{field} [<color:#218653><b>FK</b></color>] source_visit_id\n  <color:#218653>→ visit_record.visit_id</color>
{field} [<color:#218653><b>FK</b></color>] dentist_id\n  <color:#218653>→ staff.staff_id</color>
{field} [<color:#467DA6><b>UQ</b></color>/<color:#218653><b>FK</b></color>] supersedes_id\n  <color:#218653>→ followup_plan.plan_id ?</color>
}
entity "联系与提醒记录\ncontact_record" as contact_record {
{field} [<color:#176CA4><b>PK</b></color>] contact_id\n  <color:#777777>bigint</color>
{field} [<color:#218653><b>FK</b></color>] plan_id\n  <color:#218653>→ followup_plan.plan_id ?</color>
{field} [<color:#218653><b>FK</b></color>] appointment_id\n  <color:#218653>→ appointment.appointment_id ?</color>
{field} [<color:#218653><b>FK</b></color>] staff_id\n  <color:#218653>→ staff.staff_id ?</color>
{field} [<color:#467DA6><b>UQ</b></color>/<color:#218653><b>FK</b></color>] retry_of_id\n  <color:#218653>→ contact_record.contact_id ?</color>
}
}
package "其他模块引用  同名表为同一张表" #EAF3F8 {
entity "预约就诊\nappointment" as appointment {
{field} [<color:#176CA4><b>PK</b></color>] appointment_id\n  <color:#777777>bigint</color>
}
entity "工作人员\nstaff" as staff {
{field} [<color:#176CA4><b>PK</b></color>] staff_id\n  <color:#777777>bigint</color>
}
entity "接诊记录\nvisit_record" as visit_record {
{field} [<color:#176CA4><b>PK</b></color>] visit_id\n  <color:#777777>bigint</color>
}
}
' FK followup_plan.source_visit_id > visit_record.visit_id
visit_record ||--o{ followup_plan
' FK followup_plan.dentist_id > staff.staff_id
staff ||--o{ followup_plan
' FK followup_plan.supersedes_id > followup_plan.plan_id
followup_plan |o--o| followup_plan
' FK contact_record.plan_id > followup_plan.plan_id
followup_plan |o--o{ contact_record
' FK contact_record.appointment_id > appointment.appointment_id
appointment |o--o{ contact_record
' FK contact_record.staff_id > staff.staff_id
staff |o--o{ contact_record
' FK contact_record.retry_of_id > contact_record.contact_id
contact_record |o--o| contact_record
legend bottom
蓝色 PK：主键；绿色 FK：外键；蓝灰色 UQ：单列唯一。多个 PK 字段共同组成联合主键。
PK 主键   FK 外键   UQ 唯一   ? 可空
字段下方的 → 指向被引用表及主键。
图示全部主外键；完整业务字段见数据字典。
endlegend
@enduml
