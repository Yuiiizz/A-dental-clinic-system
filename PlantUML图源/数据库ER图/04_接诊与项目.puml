@startuml
hide circle
skinparam defaultFontName Microsoft YaHei
skinparam defaultFontSize 16
skinparam backgroundColor white
skinparam shadowing false
skinparam linetype ortho
skinparam ArrowColor black
skinparam ArrowThickness 1
skinparam classBorderColor black
skinparam classBackgroundColor white
skinparam classAttributeIconSize 0
skinparam packageBorderColor transparent
skinparam packageStyle rectangle
skinparam noteBackgroundColor white
skinparam noteBorderColor black
skinparam nodesep 45
skinparam ranksep 45
skinparam dpi 150
title 接诊与项目数据库 ER 图
hide methods
package "接诊与项目" #EAF5F2 {
entity "接诊记录\nvisit_record" as visit_record {
{field} [<color:#176CA4><b>PK</b></color>] visit_id\n  <color:#777777>bigint</color>
{field} [<color:#467DA6><b>UQ</b></color>/<color:#218653><b>FK</b></color>] appointment_id\n  <color:#218653>→ appointment.appointment_id</color>
{field} [<color:#218653><b>FK</b></color>] dentist_id\n  <color:#218653>→ staff.staff_id</color>
}
entity "治疗项目\nservice_item" as service_item {
{field} [<color:#176CA4><b>PK</b></color>] item_id\n  <color:#777777>bigint</color>
{field} [<color:#218653><b>FK</b></color>] category_id\n  <color:#218653>→ service_category.category_id</color>
}
entity "诊疗服务分类\nservice_category" as service_category {
{field} [<color:#176CA4><b>PK</b></color>] category_id\n  <color:#777777>bigint</color>
}
entity "诊疗项目记录\ncare_item" as care_item {
{field} [<color:#176CA4><b>PK</b></color>] care_id\n  <color:#777777>bigint</color>
{field} [<color:#218653><b>FK</b></color>] visit_id\n  <color:#218653>→ visit_record.visit_id</color>
{field} [<color:#218653><b>FK</b></color>] item_id\n  <color:#218653>→ service_item.item_id</color>
{field} [<color:#218653><b>FK</b></color>] informed_by\n  <color:#218653>→ staff.staff_id</color>
{field} [<color:#218653><b>FK</b></color>] performed_by\n  <color:#218653>→ staff.staff_id ?</color>
{field} [<color:#467DA6><b>UQ</b></color>/<color:#218653><b>FK</b></color>] supersedes_id\n  <color:#218653>→ care_item.care_id ?</color>
}
entity "项目调价记录\nservice_price_history" as service_price_history {
{field} [<color:#176CA4><b>PK</b></color>] price_id\n  <color:#777777>bigint</color>
{field} [<color:#218653><b>FK</b></color>] item_id\n  <color:#218653>→ service_item.item_id</color>
{field} [<color:#218653><b>FK</b></color>] changed_by\n  <color:#218653>→ staff.staff_id</color>
}
entity "接诊补记\nvisit_addendum" as visit_addendum {
{field} [<color:#176CA4><b>PK</b></color>] addendum_id\n  <color:#777777>bigint</color>
{field} [<color:#218653><b>FK</b></color>] visit_id\n  <color:#218653>→ visit_record.visit_id</color>
{field} [<color:#218653><b>FK</b></color>] author_id\n  <color:#218653>→ staff.staff_id</color>
{field} [<color:#467DA6><b>UQ</b></color>/<color:#218653><b>FK</b></color>] corrects_id\n  <color:#218653>→ visit_addendum.addendum_id ?</color>
}
}
package "其他模块引用  同名表为同一张表" #EAF3F8 {
entity "预约就诊\nappointment" as appointment {
{field} [<color:#176CA4><b>PK</b></color>] appointment_id\n  <color:#777777>bigint</color>
}
entity "工作人员\nstaff" as staff {
{field} [<color:#176CA4><b>PK</b></color>] staff_id\n  <color:#777777>bigint</color>
}
}
' FK visit_record.appointment_id > appointment.appointment_id
appointment ||--o| visit_record
' FK visit_record.dentist_id > staff.staff_id
staff ||--o{ visit_record
' FK service_item.category_id > service_category.category_id
service_category ||--o{ service_item
' FK care_item.visit_id > visit_record.visit_id
visit_record ||--o{ care_item
' FK care_item.item_id > service_item.item_id
service_item ||--o{ care_item
' FK care_item.informed_by > staff.staff_id
staff ||--o{ care_item
' FK care_item.performed_by > staff.staff_id
staff |o--o{ care_item
' FK care_item.supersedes_id > care_item.care_id
care_item |o--o| care_item
' FK service_price_history.item_id > service_item.item_id
service_item ||--|{ service_price_history
' FK service_price_history.changed_by > staff.staff_id
staff ||--o{ service_price_history
' FK visit_addendum.visit_id > visit_record.visit_id
visit_record ||--o{ visit_addendum
' FK visit_addendum.author_id > staff.staff_id
staff ||--o{ visit_addendum
' FK visit_addendum.corrects_id > visit_addendum.addendum_id
visit_addendum |o--o| visit_addendum
legend bottom
蓝色 PK：主键；绿色 FK：外键；蓝灰色 UQ：单列唯一。多个 PK 字段共同组成联合主键。
PK 主键   FK 外键   UQ 唯一   ? 可空
字段下方的 → 指向被引用表及主键。
图示全部主外键；完整业务字段见数据字典。
endlegend
@enduml
