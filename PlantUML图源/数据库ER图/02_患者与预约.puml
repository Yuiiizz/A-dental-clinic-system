@startuml
hide circle
skinparam defaultFontName Microsoft YaHei
skinparam defaultFontSize 16
skinparam backgroundColor white
skinparam shadowing false
skinparam linetype ortho
skinparam ArrowColor black
skinparam ArrowThickness 1
skinparam classBorderColor black
skinparam classBackgroundColor white
skinparam classAttributeIconSize 0
skinparam packageBorderColor transparent
skinparam packageStyle rectangle
skinparam noteBackgroundColor white
skinparam noteBorderColor black
skinparam nodesep 45
skinparam ranksep 45
skinparam dpi 150
title 患者与预约数据库 ER 图
hide methods
package "患者与预约" #EAF5F2 {
entity "患者\npatient" as patient {
{field} [<color:#176CA4><b>PK</b></color>] patient_id\n  <color:#777777>bigint</color>
{field} [<color:#218653><b>FK</b></color>] primary_dentist_id\n  <color:#218653>→ staff.staff_id ?</color>
}
entity "出诊安排\nschedule" as schedule {
{field} [<color:#176CA4><b>PK</b></color>] schedule_id\n  <color:#777777>bigint</color>
{field} [<color:#218653><b>FK</b></color>] dentist_id\n  <color:#218653>→ staff.staff_id</color>
}
entity "预约就诊\nappointment" as appointment {
{field} [<color:#176CA4><b>PK</b></color>] appointment_id\n  <color:#777777>bigint</color>
{field} [<color:#218653><b>FK</b></color>] patient_id\n  <color:#218653>→ patient.patient_id</color>
{field} [<color:#218653><b>FK</b></color>] schedule_id\n  <color:#218653>→ schedule.schedule_id ?</color>
{field} [<color:#218653><b>FK</b></color>] intended_dentist_id\n  <color:#218653>→ staff.staff_id ?</color>
{field} [<color:#218653><b>FK</b></color>] previous_id\n  <color:#218653>→ appointment.appointment_id ?</color>
{field} [<color:#218653><b>FK</b></color>] followup_plan_id\n  <color:#218653>→ followup_plan.plan_id ?</color>
{field} [<color:#218653><b>FK</b></color>] requested_by\n  <color:#218653>→ account.account_id</color>
}
entity "主治交接记录\ndentist_assignment" as dentist_assignment {
{field} [<color:#176CA4><b>PK</b></color>] assignment_id\n  <color:#777777>bigint</color>
{field} [<color:#218653><b>FK</b></color>] patient_id\n  <color:#218653>→ patient.patient_id</color>
{field} [<color:#218653><b>FK</b></color>] dentist_id\n  <color:#218653>→ staff.staff_id</color>
{field} [<color:#467DA6><b>UQ</b></color>/<color:#218653><b>FK</b></color>] previous_id\n  <color:#218653>→ dentist_assignment.assignment_id ?</color>
{field} [<color:#218653><b>FK</b></color>] recorded_by\n  <color:#218653>→ staff.staff_id</color>
}
entity "医生停诊时段\ndentist_unavailable" as dentist_unavailable {
{field} [<color:#176CA4><b>PK</b></color>] absence_id\n  <color:#777777>bigint</color>
{field} [<color:#218653><b>FK</b></color>] dentist_id\n  <color:#218653>→ staff.staff_id</color>
{field} [<color:#218653><b>FK</b></color>] recorded_by\n  <color:#218653>→ staff.staff_id</color>
}
entity "改约方案\nappointment_change" as appointment_change {
{field} [<color:#176CA4><b>PK</b></color>] change_id\n  <color:#777777>bigint</color>
{field} [<color:#218653><b>FK</b></color>] original_id\n  <color:#218653>→ appointment.appointment_id</color>
{field} [<color:#467DA6><b>UQ</b></color>/<color:#218653><b>FK</b></color>] proposed_id\n  <color:#218653>→ appointment.appointment_id</color>
{field} [<color:#218653><b>FK</b></color>] absence_id\n  <color:#218653>→ dentist_unavailable.absence_id ?</color>
{field} [<color:#218653><b>FK</b></color>] unavailable_id\n  <color:#218653>→ resource_unavailable.unavailable_id ?</color>
{field} [<color:#218653><b>FK</b></color>] proposed_by\n  <color:#218653>→ staff.staff_id</color>
}
}
package "其他模块引用  同名表为同一张表" #EAF3F8 {
entity "登录账号\naccount" as account {
{field} [<color:#176CA4><b>PK</b></color>] account_id\n  <color:#777777>bigint</color>
}
entity "复诊计划\nfollowup_plan" as followup_plan {
{field} [<color:#176CA4><b>PK</b></color>] plan_id\n  <color:#777777>bigint</color>
}
entity "资源禁用时段\nresource_unavailable" as resource_unavailable {
{field} [<color:#176CA4><b>PK</b></color>] unavailable_id\n  <color:#777777>bigint</color>
}
entity "工作人员\nstaff" as staff {
{field} [<color:#176CA4><b>PK</b></color>] staff_id\n  <color:#777777>bigint</color>
}
}
' FK patient.primary_dentist_id > staff.staff_id
staff |o--o{ patient
' FK schedule.dentist_id > staff.staff_id
staff ||--o{ schedule
' FK appointment.patient_id > patient.patient_id
patient ||--o{ appointment
' FK appointment.schedule_id > schedule.schedule_id
schedule |o--o{ appointment
' FK appointment.intended_dentist_id > staff.staff_id
staff |o--o{ appointment
' FK appointment.previous_id > appointment.appointment_id
appointment |o--o{ appointment
' FK appointment.followup_plan_id > followup_plan.plan_id
followup_plan |o--o{ appointment
' FK appointment.requested_by > account.account_id
account ||--o{ appointment
' FK dentist_assignment.patient_id > patient.patient_id
patient ||--o{ dentist_assignment
' FK dentist_assignment.dentist_id > staff.staff_id
staff ||--o{ dentist_assignment
' FK dentist_assignment.previous_id > dentist_assignment.assignment_id
dentist_assignment |o--o| dentist_assignment
' FK dentist_assignment.recorded_by > staff.staff_id
staff ||--o{ dentist_assignment
' FK dentist_unavailable.dentist_id > staff.staff_id
staff ||--o{ dentist_unavailable
' FK dentist_unavailable.recorded_by > staff.staff_id
staff ||--o{ dentist_unavailable
' FK appointment_change.original_id > appointment.appointment_id
appointment ||--o{ appointment_change
' FK appointment_change.proposed_id > appointment.appointment_id
appointment ||--o| appointment_change
' FK appointment_change.absence_id > dentist_unavailable.absence_id
dentist_unavailable |o--o{ appointment_change
' FK appointment_change.unavailable_id > resource_unavailable.unavailable_id
resource_unavailable |o--o{ appointment_change
' FK appointment_change.proposed_by > staff.staff_id
staff ||--o{ appointment_change
legend bottom
蓝色 PK：主键；绿色 FK：外键；蓝灰色 UQ：单列唯一。多个 PK 字段共同组成联合主键。
PK 主键   FK 外键   UQ 唯一   ? 可空
字段下方的 → 指向被引用表及主键。
图示全部主外键；完整业务字段见数据字典。
endlegend
@enduml
