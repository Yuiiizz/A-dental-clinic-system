@startuml
hide circle
skinparam defaultFontName Microsoft YaHei
skinparam defaultFontSize 16
skinparam backgroundColor white
skinparam shadowing false
skinparam linetype ortho
skinparam ArrowColor black
skinparam ArrowThickness 1
skinparam classBorderColor black
skinparam classBackgroundColor white
skinparam classAttributeIconSize 0
skinparam packageBorderColor transparent
skinparam packageStyle rectangle
skinparam noteBackgroundColor white
skinparam noteBorderColor black
skinparam nodesep 45
skinparam ranksep 45
skinparam dpi 150
title 资源安排数据库 ER 图
hide methods
package "资源安排" #EAF5F2 {
entity "诊疗资源\nresource" as resource {
{field} [<color:#176CA4><b>PK</b></color>] resource_id\n  <color:#777777>bigint</color>
{field} [<color:#218653><b>FK</b></color>] category_id\n  <color:#218653>→ resource_category.category_id</color>
}
entity "资源禁用时段\nresource_unavailable" as resource_unavailable {
{field} [<color:#176CA4><b>PK</b></color>] unavailable_id\n  <color:#777777>bigint</color>
{field} [<color:#218653><b>FK</b></color>] resource_id\n  <color:#218653>→ resource.resource_id</color>
}
entity "资源占用\nresource_booking" as resource_booking {
{field} [<color:#176CA4><b>PK</b></color>] booking_id\n  <color:#777777>bigint</color>
{field} [<color:#218653><b>FK</b></color>] appointment_id\n  <color:#218653>→ appointment.appointment_id</color>
{field} [<color:#218653><b>FK</b></color>] resource_id\n  <color:#218653>→ resource.resource_id</color>
}
}
package "其他模块引用  同名表为同一张表" #EAF3F8 {
entity "预约就诊\nappointment" as appointment {
{field} [<color:#176CA4><b>PK</b></color>] appointment_id\n  <color:#777777>bigint</color>
}
entity "资源类别\nresource_category" as resource_category {
{field} [<color:#176CA4><b>PK</b></color>] category_id\n  <color:#777777>bigint</color>
}
}
' FK resource.category_id > resource_category.category_id
resource_category ||--o{ resource
' FK resource_unavailable.resource_id > resource.resource_id
resource ||--o{ resource_unavailable
' FK resource_booking.appointment_id > appointment.appointment_id
appointment ||--o{ resource_booking
' FK resource_booking.resource_id > resource.resource_id
resource ||--o{ resource_booking
legend bottom
蓝色 PK：主键；绿色 FK：外键；蓝灰色 UQ：单列唯一。多个 PK 字段共同组成联合主键。
PK 主键   FK 外键   UQ 唯一   ? 可空
字段下方的 → 指向被引用表及主键。
图示全部主外键；完整业务字段见数据字典。
endlegend
@enduml
