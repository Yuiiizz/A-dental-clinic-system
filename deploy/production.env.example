# Copy to deploy/production.env. This file is not read by Spring directly.
# Local Compose check: SITE_ADDRESS=:80 (HTTP only, never for real miniapp).
# Public server: SITE_ADDRESS=your.domain.example (Caddy provisions HTTPS).
SITE_ADDRESS=:80
# Public-IP HTTPS experiment: CADDYFILE=deploy/Caddyfile.ip and SITE_ADDRESS=<public IPv4>.
# Share the link only after a trusted certificate and real browser login both pass.
CADDYFILE=deploy/Caddyfile
POSTGRES_DB=a_dental_teacher_demo
POSTGRES_USER=a_dental_app
# AppID is public identity, not AppSecret. Get the latter from the miniapp console.
WECHAT_APP_ID=
