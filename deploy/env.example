# A口腔诊所系统 —— 环境变量模板（无真实值，按环境复制为 .env 后填写）
# 所有密钥只经环境变量注入，禁止写入仓库或日志明文。

# ---- 数据库（local/test/production 使用不同库）----
DB_URL=jdbc:postgresql://localhost:5432/a_dental_dev
DB_USERNAME=
DB_PASSWORD=

# ---- 服务 ----
SERVER_PORT=8080

# ---- 会话与 CSRF ----
SESSION_COOKIE_NAME=A_CLINIC_SESSION
SESSION_COOKIE_SECURE=true
CSRF_HEADER_NAME=X-CSRF-Token

# ---- 微信（真实接入需 AppID/AppSecret；本地开发可开 mock）----
WECHAT_APP_ID=
WECHAT_APP_SECRET=
MOCK_WECHAT_ENABLED=false

# ---- 合成数据 seed（production 必须为 false，代码层强制）----
APP_SEED_ENABLED=false

# ---- 门店短效签到码（生产使用随机 32 字节的 Base64；禁止复用 local 演示密钥）----
CHECKIN_SIGNING_KEY=

# 测试使用专用变量，不复用开发库配置；保留测试框架的目标库隔离校验。
TEST_DB_URL=jdbc:postgresql://localhost:5432/a_dental_test
TEST_DB_USERNAME=
TEST_DB_PASSWORD=

# 本文件只是模板，Spring Boot 不会自动读取此 .env 文件。
# 当前由启动进程注入环境变量；后续 Compose 须显式声明 env_file/environment。
# 数据库迁入 Docker 后：Windows 后端使用实际映射的回环地址与端口。
# 后端也进入容器网络时：DB_URL 使用实际数据库服务名，而非 localhost。
# DB_* 为应用连接配置，不会自动创建 PostgreSQL 用户或数据库。
# 容器初始化账号、数据库与持久化卷将在 Compose 配置中单独定义和验证。
